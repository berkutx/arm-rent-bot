[Unit]
Description=Armenia Rent Telegram Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rent
Group=rent
WorkingDirectory=/opt/rent
EnvironmentFile=/opt/rent/.env
Environment=PYTHONUTF8=1
ExecStart=/opt/rent/.venv/bin/python /opt/rent/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/rent/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
